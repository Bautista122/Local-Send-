{
  "expo": {
    "name": "LocalSend",
    "slug": "movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.localsend.movil",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "LocalSend usa la red local para encontrar otros dispositivos y enviarles archivos."
      }
    },
    "android": {
      "package": "com.localsend.movil",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    }
  }
}